# Copier ce fichier en .env (ignoré par Git). Docker Compose le lit automatiquement.

# --- Airflow (docker compose --profile airflow up --build) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changez-moi
AIRFLOW_SECRET_KEY=une-chaine-aleatoire-longue
# Linux uniquement : identifiant utilisateur qui écrit dans ./data (résultat de `id -u`). Windows : ne rien changer.
AIRFLOW_UID=50000

# Conteneur M4 : demande de trafic, scenarios SUMO (actuel, rue fermee, pic +30 %)
# et indicateurs. Meme version de SUMO que sim/ (regle d'equipe : 1.28.0).
#
# Un scenario :  docker compose run --rm traffic python run_scenario.py rue_fermee
# Les trois :    docker compose run --rm traffic python run_scenario.py all
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    libatomic1 \
    libx11-6 libxext6 libxrender1 libxcursor1 libxft2 libxi6 libxrandr2 \
    libgl1 libglu1-mesa libfontconfig1 libxerces-c3.2 \
    && rm -rf /var/lib/apt/lists/*

# Connexion lente : on utilise d'abord les fichiers .whl deposes dans traffic/wheels/
# (voir instructions), sinon pip telecharge avec plus de patience et reprise.
COPY wheels /wheels
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir --retries 10 --timeout 120 --resume-retries 20 \
    --find-links=/wheels eclipse-sumo==1.28.0

ENV SUMO_HOME=/usr/local/lib/python3.11/site-packages/sumo
ENV PATH="/usr/local/bin:${PATH}"

WORKDIR /app
COPY *.py ./

ENV DATA_DIR=/data PYTHONUNBUFFERED=1
VOLUME /data
CMD ["python", "generate_demand.py"]
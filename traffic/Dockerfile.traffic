# Conteneur M4 : genere la demande de trafic (data/demand.csv)
# et calcule les 4 indicateurs (data/kpi_<scenario>.json). Python standard uniquement.
#
# Demande :     docker compose up --build traffic
# Indicateurs : docker compose run --rm traffic python compute_kpi.py --scenario actuel
FROM python:3.11-slim

WORKDIR /app
COPY generate_demand.py compute_kpi.py ./

ENV DATA_DIR=/data PYTHONUNBUFFERED=1
VOLUME /data
CMD ["python", "generate_demand.py"]